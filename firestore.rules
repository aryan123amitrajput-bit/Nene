rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidUser(data) {
        return data.keys().hasAll(['uid', 'displayName', 'uniqueToken']) &&
               data.uid is string &&
               data.displayName is string &&
               data.uniqueToken is string &&
               data.uid == request.auth.uid;
    }

    function isValidMessage(data) {
        return data.keys().hasAll(['text', 'senderId', 'createdAt']) &&
               data.text is string &&
               data.senderId == request.auth.uid &&
               data.createdAt is number;
    }

    // Users
    match /users/{uid} {
        allow get, list: if isSignedIn();
        allow create: if isSignedIn() && isOwner(uid) && isValidUser(incoming());
        allow update: if isSignedIn() && isOwner(uid) && incoming().diff(existing()).affectedKeys().hasOnly(['displayName']) && incoming().displayName is string;
    }

    // Chats
    match /chats/{chatId} {
        allow read: if isSignedIn() && request.auth.uid in resource.data.participants;
        allow create: if isSignedIn() && 
                         request.resource.data.participants is list && 
                         request.auth.uid in request.resource.data.participants;
        allow update: if isSignedIn() && 
                         request.auth.uid in resource.data.participants &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['gistIds']) &&
                         incoming().gistIds is list;
    }
  }
}
